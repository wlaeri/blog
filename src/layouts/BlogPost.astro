---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  date: Date;
}

const { title, subtitle, description, date } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <article>
    <header>
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer>
      <a href="/">&larr; Back to all posts</a>
    </footer>
  </article>
</Base>

<style>
  article header {
    margin-bottom: 2rem;
    border-bottom: none;
    padding: 0;
    text-align: left;
  }

  time {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 300;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: 0.25rem;
    line-height: 1.3;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    font-weight: 400;
    margin-top: 0.375rem;
    line-height: 1.5;
  }

  .prose {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(a) {
    color: var(--color-accent);
    font-weight: 500;
  }

  .prose :global(code) {
    font-size: 0.875rem;
    background: var(--color-border);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }

  .prose :global(pre) {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.25rem 0;
    border-radius: 8px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  article footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: left;
  }

  article footer a {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
